{
  "name": "murder-mystery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run pdf-manager#dev",
    "build": "vp run -r build",
    "deploy": "vp run pdf-manager#build && vp run pdf-manager#deploy",
    "ui": "vp run --no-cache --filter=@repo/ui ui",
    "ui:pdf-manager": "vp run --no-cache --filter=pdf-manager ui",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
