{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memo",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // Vite の `base` と同じパス配下で配信する。プレフィックスを外して Static Assets に
  // 渡すのは Worker の仕事なので、全リクエストを先に Worker に通す。
  "main": "./worker/index.ts",
  // The Vite plugin points `assets.directory` at the client build output.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "tanakalucky.com/murder-mystery-memo", "zone_name": "tanakalucky.com" },
    { "pattern": "tanakalucky.com/murder-mystery-memo/*", "zone_name": "tanakalucky.com" },
  ],
  "workers_dev": true,
}
