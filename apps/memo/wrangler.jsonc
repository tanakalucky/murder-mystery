{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memo",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // Worker のコードは持たず、`vp build` の出力をそのまま Static Assets として配信する
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // DNS レコードと証明書は Cloudflare が作る
  "routes": [{ "pattern": "memo.tanakalucky.com", "custom_domain": true }],
  "workers_dev": true,
}
